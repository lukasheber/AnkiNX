--- a/build.rs
+++ b/build.rs
@@ -0,0 +1,12 @@
+// Added for the Nintendo Switch port: `cfg(libnx)` marks Horizon OS on aarch64
+// (devkitA64 newlib + libnx), as opposed to the 3DS, which shares
+// `target_os = "horizon"` but has a different socket stack and no usable waker.
+fn main() {
+    println!("cargo:rerun-if-changed=build.rs");
+    println!("cargo:rustc-check-cfg=cfg(libnx)");
+    let os = std::env::var("CARGO_CFG_TARGET_OS").unwrap_or_default();
+    let arch = std::env::var("CARGO_CFG_TARGET_ARCH").unwrap_or_default();
+    if os == "horizon" && arch == "aarch64" {
+        println!("cargo:rustc-cfg=libnx");
+    }
+}
