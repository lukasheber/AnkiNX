+        io::Error::new(io::ErrorKind::InvalidData, "damaged RWKV state")
+    }
+    if read_state_cache_u32(input)? as usize != layers {
+        return Err(damaged());
+    }
+    fn read_values(
+        input: &mut impl io::Read,
+        buffer: &mut Vec<u8>,
+        want: usize,
