+/// HEAD_SIZE²) and channel shift (D_MODEL); anything else is a damaged file.
+fn read_half_module_state(
+    input: &mut impl io::Read,
+    buffer: &mut Vec<u8>,
+    layers: usize,
+) -> io::Result<ModuleState> {
