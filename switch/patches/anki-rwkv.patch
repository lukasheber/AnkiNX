+        child.normal_mut()?.config_id = parent.config_id().unwrap().0;
+        col.add_or_update_deck(&mut child)?;
+        let other = DeckAdder::new("parent::other")
+            .with_config(|config| config.inner.rwkv_review_instant_order_enabled = true)
