+        let matrix = read_values(input, buffer, HEADS * HEAD_SIZE * HEAD_SIZE)?;
+        let channel_shift = read_values_or_none(input, buffer, D_MODEL)?;
+        states.push(LayerState {
+            time: Some(TimeState {
+                x_shift,
+                matrix,
+                packed_matrix: None,
+            }),
+            channel_shift,
+        });
+    }
+    Ok(ModuleState {
+        layers: states,
+        packed: None,
+    })
