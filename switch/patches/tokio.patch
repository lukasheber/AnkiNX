diff -ruN a/src/signal/ctrl_c.rs b/src/signal/ctrl_c.rs
--- a/src/signal/ctrl_c.rs
+++ b/src/signal/ctrl_c.rs
@@ -1,4 +1,4 @@
-#[cfg(unix)]
+#[cfg(all(unix, not(target_os = "horizon")))]
 use super::unix::{self as os_impl};
 #[cfg(windows)]
 use super::windows::{self as os_impl};
@@ -56,7 +56,17 @@
 ///     // Your handler here
 /// });
 /// ```
+#[cfg(not(target_os = "horizon"))]
 pub async fn ctrl_c() -> io::Result<()> {
     os_impl::ctrl_c()?.recv().await;
     Ok(())
 }
+
+/// Horizon OS has no signals, so there is no "ctrl-c" to listen for.
+#[cfg(target_os = "horizon")]
+pub async fn ctrl_c() -> io::Result<()> {
+    Err(io::Error::new(
+        io::ErrorKind::Unsupported,
+        "signals are not supported on Horizon OS",
+    ))
+}
