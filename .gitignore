# --- Fetched dependencies (reproducible) -----------------------------------
# borealis, litehtml, lunasvg: tools/fetch_frontend_deps.sh at the commits in PINS
/app/library/*
!/app/library/PINS
# Patched crates: switch/tools/vendor.sh apply (switch/vendor.lst + switch/patches/)
/switch/vendor/
# Nintendo's system fonts for the desktop preview, copied from borealis by
# tools/fetch_frontend_deps.sh (not ours to license)
/app/resources/font/

