<brls:AppletFrame
    id="frame"
    iconInterpolation="linear"
    footerHidden="false">

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        grow="1.0">

        <!-- New / learning / due counts (the current card's queue is underlined),
             centred; on the right the card's flag and mark, and the card menu -->
        <brls:Box
            width="auto"
            height="40"
            axis="row"
            alignItems="center">
            <!-- Answer timer (deck option), mirroring the menu on the right -->
            <brls:Box width="0" height="auto" grow="1.0" axis="row" alignItems="center">
                <brls:Label id="timerLabel" width="auto" height="auto" fontSize="22" textColor="#888888" marginLeft="40"
                    visibility="gone" />
            </brls:Box>
            <brls:Label id="countNew" width="auto" height="auto" fontSize="22" textColor="#42a5f5" marginRight="28" />
            <brls:Label id="countLearn" width="auto" height="auto" fontSize="22" textColor="#ef5350" marginRight="28" />
            <brls:Label id="countReview" width="auto" height="auto" fontSize="22" textColor="#66bb6a" />
            <brls:Box width="0" height="auto" grow="1.0" axis="row" justifyContent="flexEnd" alignItems="center"
                marginRight="14">
                <brls:Box id="flagIcon" width="18" height="18" cornerRadius="9" marginRight="14" visibility="gone" />
                <brls:Label id="markIcon" width="auto" height="auto" fontSize="26" textColor="#f5b400"
                    marginRight="4" visibility="gone" />
                <!-- A finger-sized target around the ⋯ -->
                <brls:Box id="menuButton" width="64" height="40" justifyContent="center" alignItems="center">
                    <brls:Label id="menuIcon" width="auto" height="auto" fontSize="30" />
                </brls:Box>
            </brls:Box>
        </brls:Box>

        <!-- A flagged card's colour along its top edge, as in AnkiDroid -->
        <brls:Box id="flagBar" width="auto" height="4" marginLeft="24" marginRight="24" visibility="invisible" />

        <CardView
            id="card"
            width="auto"
            height="auto"
            grow="1.0"
            marginLeft="24"
            marginRight="24" />

        <brls:Box
            width="auto"
            height="100"
            axis="row"
            justifyContent="center"
            alignItems="center">

            <brls:Box
                id="showAnswer"
                width="440"
                height="72"
                axis="column"
                justifyContent="center"
                alignItems="center"
                cornerRadius="10"
                backgroundColor="#3b82f6">
                <brls:Label id="showAnswerLabel" width="auto" height="auto" fontSize="24" textColor="#ffffff" />
            </brls:Box>

            <brls:Box id="easeButtons" width="auto" height="auto" axis="row" visibility="gone">
                <brls:Box id="ease1" width="236" height="72" marginLeft="8" marginRight="8" axis="column"
                    justifyContent="center" alignItems="center" cornerRadius="10" backgroundColor="#e53935">
                    <brls:Label id="ease1Time" width="auto" height="auto" fontSize="16" textColor="#ffffff" />
                    <brls:Label id="ease1Name" width="auto" height="auto" fontSize="22" textColor="#ffffff" />
                </brls:Box>
                <brls:Box id="ease2" width="236" height="72" marginLeft="8" marginRight="8" axis="column"
                    justifyContent="center" alignItems="center" cornerRadius="10" backgroundColor="#757575">
                    <brls:Label id="ease2Time" width="auto" height="auto" fontSize="16" textColor="#ffffff" />
                    <brls:Label id="ease2Name" width="auto" height="auto" fontSize="22" textColor="#ffffff" />
                </brls:Box>
                <brls:Box id="ease3" width="236" height="72" marginLeft="8" marginRight="8" axis="column"
                    justifyContent="center" alignItems="center" cornerRadius="10" backgroundColor="#43a047">
                    <brls:Label id="ease3Time" width="auto" height="auto" fontSize="16" textColor="#ffffff" />
                    <brls:Label id="ease3Name" width="auto" height="auto" fontSize="22" textColor="#ffffff" />
                </brls:Box>
                <brls:Box id="ease4" width="236" height="72" marginLeft="8" marginRight="8" axis="column"
                    justifyContent="center" alignItems="center" cornerRadius="10" backgroundColor="#1e88e5">
                    <brls:Label id="ease4Time" width="auto" height="auto" fontSize="16" textColor="#ffffff" />
                    <brls:Label id="ease4Name" width="auto" height="auto" fontSize="22" textColor="#ffffff" />
                </brls:Box>
            </brls:Box>
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
