<brls:AppletFrame
    id="frame"
    iconInterpolation="linear"
    footerHidden="false">

    <brls:Box
        width="auto"
        height="auto"
        axis="column"
        alignItems="center"
        grow="1.0">

        <!-- The table is as wide as its longest deck name needs (fitTable()),
             centred, with the column titles above its counts. -->
        <brls:Box
            width="auto"
            height="40"
            axis="row"
            alignSelf="stretch"
            justifyContent="center"
            alignItems="center">
            <brls:Box
                id="columns"
                width="auto"
                height="40"
                axis="row"
                justifyContent="flexEnd"
                alignItems="center"
                paddingRight="70">
                <brls:Label width="90" height="auto" fontSize="16" horizontalAlign="right" textColor="#42a5f5" text="@i18n/ankinx/decks/col_new" />
                <brls:Label width="90" height="auto" fontSize="16" horizontalAlign="right" textColor="#ef5350" text="@i18n/ankinx/decks/col_learn" />
                <brls:Label width="90" height="auto" fontSize="16" horizontalAlign="right" textColor="#66bb6a" text="@i18n/ankinx/decks/col_due" />
            </brls:Box>
        </brls:Box>

        <brls:Label
            id="message"
            width="auto"
            height="auto"
            grow="1.0"
            fontSize="22"
            horizontalAlign="center"
            verticalAlign="center"
            visibility="gone" />

        <brls:RecyclerFrame
            id="decks"
            width="auto"
            height="auto"
            grow="1.0"
            paddingBottom="12"
            lineColor="@theme/brls/sidebar/separator"
            lineBottom="1" />

        <!-- Status line, fixed under the list: the AnkiWeb account on the
             left (in line with the title), today's study in the middle.
             Colours are set in deck_picker.cpp (theme). -->
        <brls:Box
            width="auto"
            height="44"
            axis="row"
            alignSelf="stretch"
            justifyContent="center"
            alignItems="center">
            <brls:Label id="account" positionType="absolute" positionLeft="65" positionTop="12" width="auto"
                height="auto" fontSize="16" singleLine="true" />
            <brls:Label id="studiedToday" width="auto" height="auto" fontSize="17" singleLine="true" />
        </brls:Box>
    </brls:Box>
</brls:AppletFrame>
