diff --git a/src/render_grid.cpp b/src/render_grid.cpp
new file mode 100644
index 00000000..91cbb5a1
--- /dev/null
+++ b/src/render_grid.cpp
@@ -0,0 +1,542 @@
+#include "types.h"
+#include "render_grid.h"
+#include "html_tag.h"
+#include "document.h"
+#include "css_parser.h"
+
+namespace
+{
+    using namespace litehtml;
+
+    struct grid_track
+    {
+        float size = 0; // px, for a fixed track or once resolved
+        float fr   = 0; // flexible share (0: fixed)
+        float min  = 0; // minimum of a minmax() flexible track
+    };
+
+    std::string lower(std::string s)
+    {
+        for(auto& c : s)
+        {
+            c = static_cast<char>(std::tolower(static_cast<unsigned char>(c)));
+        }
+        return s;
+    }
+
+    bool is_fr(const css_token& t)
+    {
+        return t.type == DIMENSION && lower(t.unit()) == "fr";
+    }
+
+    // The tokens of a property value, whitespace dropped.
+    css_token_vector value_tokens(const std::string& value)
+    {
+        css_token_vector ret;
+        for(const auto& t : normalize(value, f_componentize))
+        {
+            if(t.type != WHITESPACE)
+            {
+                ret.push_back(t);
+            }
+        }
+        return ret;
+    }
+
+    // A function's arguments, split at commas, whitespace dropped.
+    std::vector<css_token_vector> function_args(const css_token& fn)
+    {
+        std::vector<css_token_vector> args(1);
+        for(const auto& t : fn.value)
+        {
+            if(t.type == COMMA)
+            {
+                args.emplace_back();
+            } else if(t.type != WHITESPACE)
+            {
+                args.back().push_back(t);
+            }
+        }
+        return args;
+    }
+
+    // start/center/end/stretch from align-* or justify-* values.
+    enum class grid_align
+    {
+        stretch,
+        start,
+        center,
+        end
+    };
+
+    grid_align align_from_word(const std::string& word, grid_align fallback)
+    {
+        std::string w = lower(word);
+        if(w == "center")
+        {
+            return grid_align::center;
+        }
+        if(w == "start" || w == "flex-start" || w == "self-start" || w == "left" || w == "baseline")
+        {
+            return grid_align::start;
+        }
+        if(w == "end" || w == "flex-end" || w == "self-end" || w == "right")
+        {
+            return grid_align::end;
+        }
+        if(w == "stretch" || w == "normal")
+        {
+            return grid_align::stretch;
+        }
+        return fallback;
+    }
+
+    grid_align align_from_enum(int value, grid_align fallback)
+    {
+        switch(value & 0xff)
+        {
+        case flex_align_items_center:
+            return grid_align::center;
+        case flex_align_items_start:
+        case flex_align_items_self_start:
+        case flex_align_items_flex_start:
+        case flex_align_items_baseline:
+            return grid_align::start;
+        case flex_align_items_end:
+        case flex_align_items_self_end:
+        case flex_align_items_flex_end:
+            return grid_align::end;
+        case flex_align_items_stretch:
+            return grid_align::stretch;
+        default:
+            return fallback;
+        }
+    }
+
+    // The n-th word (0: align, 1: justify) of a place-* shorthand; a single
+    // word sets both.
+    std::string place_word(const std::string& value, size_t n)
+    {
+        auto words = value_tokens(value);
+        if(words.empty())
+        {
+            return "";
+        }
+        return (n < words.size() ? words[n] : words[0]).ident();
+    }
+} // namespace
+
+std::shared_ptr<litehtml::render_item> litehtml::render_item_grid::init()
+{
+    // As render_item_flex::init: runs of text become anonymous block items.
+    src_el()->add_render(shared_from_this());
+    decltype(m_children) new_children;
+    decltype(m_children) inlines;
+
+    auto convert_inlines = [&]() {
+        if(!inlines.empty())
+        {
+            auto not_space =
+                std::find_if(inlines.rbegin(), inlines.rend(),
+                             [&](const std::shared_ptr<render_item>& el) { return !el->src_el()->is_space(); });
+            if(not_space != inlines.rend())
+            {
+                inlines.erase((not_space.base()), inlines.end());
+            }
+
+            auto anon_el = std::make_shared<html_tag>(src_el());
+            auto anon_ri = std::make_shared<render_item_block>(anon_el);
+            for(const auto& inl : inlines)
+            {
+                anon_ri->add_child(inl);
+            }
+            anon_ri->parent(shared_from_this());
+
+            new_children.push_back(anon_ri->init());
+            inlines.clear();
+        }
+    };
+
+    for(const auto& el : m_children)
+    {
+        if(el->src_el()->css().get_display() == display_inline_text)
+        {
+            if(!inlines.empty() || !el->src_el()->is_white_space())
+            {
+                inlines.push_back(el);
+            }
+        } else
+        {
+            convert_inlines();
+            if(el->src_el()->is_block_box())
+            {
+                el->parent(shared_from_this());
+                new_children.push_back(el->init());
+            } else
+            {
+                auto anon_el = std::make_shared<html_tag>(el->src_el());
+                auto anon_ri = std::make_shared<render_item_block>(anon_el);
+                anon_ri->add_child(el->init());
+                anon_ri->parent(shared_from_this());
+                new_children.push_back(anon_ri->init());
+            }
+        }
+    }
+    convert_inlines();
+    children() = new_children;
+
+    return shared_from_this();
+}
+
+litehtml::rendered_width litehtml::render_item_grid::_render_content(pixel_t x, pixel_t y, bool /*second_pass*/,
+                                                                     const containing_block_context& self_size,
+                                                                     formatting_context*             fmt_ctx)
+{
+    auto                doc   = src_el()->get_document();
+    const font_metrics& fm    = css().get_font_metrics();
+    const float         width = static_cast<float>(self_size.render_width.value);
+
+    auto length = [&](const css_token& t, float percent_of, float& out) {
+        css_length len;
+        if(!len.from_token(t, f_length_percentage))
+        {
+            return false;
+        }
+        out = doc->to_pixels(len, fm, pixel_t(percent_of));
+        return true;
+    };
+
+    float col_gap = 0, row_gap = 0;
+    if(auto g = value_tokens(css().get_column_gap()); !g.empty())
+    {
+        length(g[0], width, col_gap);
+    }
+    if(auto g = value_tokens(css().get_row_gap()); !g.empty())
+    {
+        length(g[0], 0, row_gap);
+    }
+
+    /////////////////////////////////////////////////////////////////
+    /// Columns
+    /////////////////////////////////////////////////////////////////
+    auto parse_track = [&](const css_token& t) {
+        grid_track tr;
+        if(is_fr(t))
+        {
+            tr.fr = t.n.number;
+        } else if(t.type == CV_FUNCTION && lower(t.name()) == "minmax")
+        {
+            auto args = function_args(t);
+            if(args.size() == 2 && !args[0].empty() && !args[1].empty())
+            {
+                length(args[0][0], width, tr.min);
+                if(is_fr(args[1][0]))
+                {
+                    tr.fr = args[1][0].n.number;
+                } else if(length(args[1][0], width, tr.size))
+                {
+                    tr.size = std::max(tr.size, tr.min);
+                } else
+                {
+                    tr.fr = 1; // minmax(x, auto/max-content)
+                }
+            } else
+            {
+                tr.fr = 1;
+            }
+        } else if(!length(t, width, tr.size))
+        {
+            tr.fr = 1; // auto, min-content, max-content, fit-content(): share the free space
+        }
+        return tr;
+    };
+
+    std::vector<grid_track> tracks;
+    for(const auto& t : value_tokens(css().get_grid_template_columns()))
+    {
+        if(t.type == CV_FUNCTION && lower(t.name()) == "repeat")
+        {
+            auto args = function_args(t);
+            if(args.size() < 2 || args[0].empty())
+            {
+                continue;
+            }
+            std::vector<grid_track> pattern;
+            for(size_t i = 1; i < args.size(); i++) // a track list with commas inside minmax() was split
+            {
+                for(const auto& tt : args[i])
+                {
+                    if(tt.type != SQUARE_BLOCK)
+                    {
+                        pattern.push_back(parse_track(tt));
+                    }
+                }
+            }
+            if(pattern.empty())
+            {
+                continue;
+            }
+            int         count = 1;
+            std::string word  = lower(args[0][0].ident());
+            if(args[0][0].type == NUMBER)
+            {
+                count = std::max(1, static_cast<int>(args[0][0].n.number));
+            } else if(word == "auto-fill" || word == "auto-fit")
+            {
+                // As many repetitions as fit, each track at its minimum.
+                float rep = 0;
+                for(const auto& tr : pattern)
+                {
+                    rep += (tr.fr > 0 ? tr.min : tr.size) + col_gap;
+                }
+                count = rep > 0 ? std::max(1, static_cast<int>((width + col_gap) / rep)) : 1;
+                if(word == "auto-fit")
+                {
+                    // Empty repetitions collapse: no more columns than items.
+                    int items = 0;
+                    for(const auto& el : m_children)
+                    {
+                        if(!el->src_el()->is_positioned() || el->src_el()->css().get_position() == element_position_relative)
+                        {
+                            items++;
+                        }
+                    }
+                    count = std::max(1, std::min(count, (items + static_cast<int>(pattern.size()) - 1) /
+                                                            static_cast<int>(pattern.size())));
+                }
+            }
+            for(int i = 0; i < count; i++)
+            {
+                tracks.insert(tracks.end(), pattern.begin(), pattern.end());
+            }
+        } else if(t.type != SQUARE_BLOCK) // [line names]
+        {
+            tracks.push_back(parse_track(t));
+        }
+    }
+    if(tracks.empty())
+    {
+        tracks.push_back(grid_track{0, 1, 0});
+    }
+
+    // Fixed tracks first; flexible ones share the rest, but not below their minimum.
+    const size_t n         = tracks.size();
+    float        free_size = width - col_gap * static_cast<float>(n - 1);
+    float        fr_sum    = 0;
+    for(const auto& tr : tracks)
+    {
+        if(tr.fr > 0)
+        {
+            fr_sum += tr.fr;
+        } else
+        {
+            free_size -= tr.size;
+        }
+    }
+    while(fr_sum > 0)
+    {
+        float unit    = std::max(0.0f, free_size) / fr_sum;
+        bool  clamped = false;
+        for(auto& tr : tracks)
+        {
+            if(tr.fr > 0 && unit * tr.fr < tr.min)
+            {
+                tr.size    = tr.min;
+                free_size -= tr.min;
+                fr_sum    -= tr.fr;
+                tr.fr      = 0;
+                clamped    = true;
+            }
+        }
+        if(!clamped)
+        {
+            for(auto& tr : tracks)
+            {
+                if(tr.fr > 0)
+                {
+                    tr.size = unit * tr.fr;
+                }
+            }
+            break;
+        }
+    }
+    std::vector<float> col_x(n);
+    float              total_width = 0;
+    for(size_t i = 0; i < n; i++)
+    {
+        col_x[i]     = total_width;
+        total_width += tracks[i].size + (i + 1 < n ? col_gap : 0);
+    }
+
+    /////////////////////////////////////////////////////////////////
+    /// Items, a row at a time
+    /////////////////////////////////////////////////////////////////
+    grid_align container_align   = align_from_enum(css().get_flex_align_items(), grid_align::stretch);
+    grid_align container_justify = align_from_word(css().get_justify_items(), grid_align::stretch);
+    if(!css().get_place_items().empty())
+    {
+        container_align   = align_from_word(place_word(css().get_place_items(), 0), container_align);
+        container_justify = align_from_word(place_word(css().get_place_items(), 1), container_justify);
+    }
+
+    struct placed
+    {
+        std::shared_ptr<render_item> el;
+        grid_align                   align;
+    };
+    std::vector<placed> row;
+    float               row_top = 0;
+    size_t              col     = 0;
+    bool                any_row = false;
+
+    auto finish_row = [&]() {
+        if(row.empty())
+        {
+            col = 0;
+            return;
+        }
+        float row_height = 0;
+        for(const auto& p : row)
+        {
+            row_height = std::max(row_height, static_cast<float>(p.el->height()));
+        }
+        for(const auto& p : row)
+        {
+            float extra = row_height - p.el->height();
+            switch(p.align)
+            {
+            case grid_align::stretch:
+                if(p.el->src_el()->css().get_height().is_predefined())
+                {
+                    p.el->pos().height += pixel_t(extra);
+                }
+                break;
+            case grid_align::center:
+                p.el->pos().y += pixel_t(extra / 2);
+                break;
+            case grid_align::end:
+                p.el->pos().y += pixel_t(extra);
+                break;
+            case grid_align::start:
+                break;
+            }
+        }
+        row_top += row_height + row_gap;
+        any_row  = true;
+        row.clear();
+        col = 0;
+    };
+
+    for(const auto& el : m_children)
+    {
+        const auto& item_css = el->src_el()->css();
+        if(item_css.get_display() == display_none)
+        {
+            continue;
+        }
+        if(item_css.get_position() == element_position_absolute || item_css.get_position() == element_position_fixed)
+        {
+            // Out of flow: laid out for render_positioned, as block layout does.
+            el->render(0_px, pixel_t(row_top), self_size, fmt_ctx);
+            continue;
+        }
+
+        // grid-column: N | span N | N / M | N / span M (lines count from 1; -1 is the last)
+        size_t start = 0, span = 1; // start 0: auto
+        {
+            auto   tokens = value_tokens(item_css.get_grid_column());
+            size_t slash  = tokens.size();
+            for(size_t i = 0; i < tokens.size(); i++)
+            {
+                if(tokens[i].type == '/')
+                {
+                    slash = i;
+                    break;
+                }
+            }
+            auto line = [&](float v) { return v < 0 ? static_cast<int>(n) + 2 + static_cast<int>(v) : static_cast<int>(v); };
+            for(size_t i = 0; i < slash; i++)
+            {
+                if(tokens[i].ident() == "span" && i + 1 < slash && tokens[i + 1].type == NUMBER)
+                {
+                    span = static_cast<size_t>(std::max(1.0f, tokens[++i].n.number));
+                } else if(tokens[i].type == NUMBER)
+                {
+                    start = static_cast<size_t>(std::max(1, line(tokens[i].n.number)));
+                }
+            }
+            for(size_t i = slash + 1; i < tokens.size(); i++)
+            {
+                if(tokens[i].ident() == "span" && i + 1 < tokens.size() && tokens[i + 1].type == NUMBER)
+                {
+                    span = static_cast<size_t>(std::max(1.0f, tokens[++i].n.number));
+                } else if(tokens[i].type == NUMBER && start > 0)
+                {
+                    int end = line(tokens[i].n.number);
+                    span    = static_cast<size_t>(std::max(1, end - static_cast<int>(start)));
+                }
+            }
+            span = std::min(span, n);
+        }
+        if(start > 0)
+        {
+            size_t wanted = std::min(start - 1, n - span);
+            if(wanted < col)
+            {
+                finish_row();
+            }
+            col = wanted;
+        }
+        if(col + span > n)
+        {
+            finish_row();
+        }
+
+        float cell_x     = col_x[col];
+        float cell_width = col_x[col + span - 1] + tracks[col + span - 1].size - cell_x;
+
+        grid_align justify = container_justify;
+        grid_align align   = align_from_enum(item_css.get_flex_align_self(), container_align);
+        if(auto self = el->src_el()->css().get_justify_self(); !self.empty())
+        {
+            justify = align_from_word(value_tokens(self).empty() ? "" : value_tokens(self)[0].ident(), justify);
+        }
+        if(auto place = item_css.get_place_self(); !place.empty())
+        {
+            align   = align_from_word(place_word(place, 0), align);
+            justify = align_from_word(place_word(place, 1), justify);
+        }
+
+        auto cell = self_size.new_width(pixel_t(cell_width));
+        auto rw   = el->render(pixel_t(cell_x), pixel_t(row_top), cell, fmt_ctx);
+        if(justify != grid_align::stretch && item_css.get_width().is_predefined() &&
+           rw.natural_width < el->width())
+        {
+            // Not stretched: as wide as its content.
+            el->render(pixel_t(cell_x), pixel_t(row_top), cell.new_width(rw.natural_width), fmt_ctx);
+        }
+        float extra = cell_width - el->width();
+        if(justify == grid_align::center)
+        {
+            el->pos().x += pixel_t(extra / 2);
+        } else if(justify == grid_align::end)
+        {
+            el->pos().x += pixel_t(extra);
+        }
+
+        row.push_back({el, align});
+        col += span;
+        if(col >= n)
+        {
+            finish_row();
+        }
+    }
+    finish_row();
+
+    m_pos.height = pixel_t(any_row ? row_top - row_gap : 0.0f);
+    m_pos.move_to(x, y);
+    m_pos.x += content_offset_left();
+    m_pos.y += content_offset_top();
+
+    return {pixel_t(total_width), pixel_t(total_width)};
+}
